---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../content/landing.json';
---
<BaseLayout title={content.meta.title} description={content.meta.description}>
  <nav class="sticky top-0 z-50 bg-gradient-to-r from-blue-600 to-blue-800 text-white shadow-lg">
    <div class="max-w-6xl mx-auto px-4 md:px-8 py-4 flex justify-between items-center">
      <div class="nav-brand">
        <h1 class="text-2xl md:text-3xl font-bold text-white">Europlasmet</h1>
      </div>
      <ul class="hidden md:flex gap-8 text-sm md:text-base">
        <li><a href="#home" class="hover:opacity-80 transition">Home</a></li>
        <li><a href="#products" class="hover:opacity-80 transition">Products</a></li>
        <li><a href="#about" class="hover:opacity-80 transition">About</a></li>
        <li><a href="#contact" class="hover:opacity-80 transition">Contact</a></li>
      </ul>
      <button id="menu-toggle" class="md:hidden text-xl">☰</button>
    </div>
    <div id="mobile-menu" class="hidden md:hidden bg-blue-700 px-4 py-3">
      <ul class="flex flex-col gap-3 text-sm">
        <li><a href="#home" class="hover:opacity-80 transition block">Home</a></li>
        <li><a href="#products" class="hover:opacity-80 transition block">Products</a></li>
        <li><a href="#about" class="hover:opacity-80 transition block">About</a></li>
        <li><a href="#contact" class="hover:opacity-80 transition block">Contact</a></li>
      </ul>
    </div>
  </nav>

  <div id="mascot-container" class="fixed bottom-4 right-4 z-40">
    <div class="relative">
      <svg id="mascot" class="mascot-character w-16 h-16 md:w-24 md:h-24 cursor-pointer" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <style>
            @keyframes bounce {
              0%, 100% { transform: translateY(0); }
              50% { transform: translateY(-10px); }
            }
            @keyframes float {
              0%, 100% { transform: translateY(0px) rotate(0deg); }
              50% { transform: translateY(-5px) rotate(5deg); }
            }
            .pellet-body {
              animation: float 3s ease-in-out infinite;
            }
          </style>
        </defs>
        <ellipse class="pellet-body" cx="50" cy="50" rx="35" ry="38" fill="#FF6B35" stroke="#E55A28" stroke-width="2"/>
        <ellipse cx="35" cy="35" rx="12" ry="15" fill="rgba(255, 255, 255, 0.4)"/>
        <circle cx="40" cy="45" r="6" fill="white" stroke="#333" stroke-width="1"/>
        <circle cx="40" cy="45" r="3" fill="#333"/>
        <circle cx="41" cy="43" r="1.5" fill="white"/>
        <circle cx="60" cy="45" r="6" fill="white" stroke="#333" stroke-width="1"/>
        <circle cx="60" cy="45" r="3" fill="#333"/>
        <circle cx="61" cy="43" r="1.5" fill="white"/>
        <path d="M 40 60 Q 50 68 60 60" stroke="#333" stroke-width="2" fill="none" stroke-linecap="round"/>
        <rect x="15" y="48" width="20" height="8" rx="4" fill="#FF6B35" stroke="#E55A28" stroke-width="1"/>
        <rect x="65" y="48" width="20" height="8" rx="4" fill="#FF6B35" stroke="#E55A28" stroke-width="1"/>
        <ellipse cx="38" cy="88" rx="8" ry="6" fill="#FF6B35" stroke="#E55A28" stroke-width="1"/>
        <ellipse cx="62" cy="88" rx="8" ry="6" fill="#FF6B35" stroke="#E55A28" stroke-width="1"/>
      </svg>
      <div id="mascot-message" class="mascot-message hidden absolute -top-28 right-0 bg-white border-2 border-orange-500 rounded-lg shadow-lg px-4 py-2 whitespace-nowrap text-sm font-semibold text-gray-800 pointer-events-none">
        <span id="message-text">👋 Need help?</span>
        <div class="absolute bottom-0 right-4 transform translate-y-full triangle-down"></div>
      </div>
    </div>
  </div>

  <section id="home" class="hero-section bg-gradient-to-r from-blue-600 to-blue-800 text-white py-16 md:py-32 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-5xl font-bold mb-4 md:mb-6 leading-tight">{content.hero.title}</h2>
      <p class="text-lg md:text-xl mb-6 md:mb-8 opacity-90">{content.hero.subtitle}</p>
      <a href={content.hero.ctaLink} class="cta-button inline-block bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 md:py-4 px-6 md:px-10 rounded-lg text-base md:text-lg transition transform hover:-translate-y-1 shadow-lg">{content.hero.ctaText}</a>
      <div class="mobile-only mt-8 md:hidden bg-blue-500 bg-opacity-50 p-4 rounded-lg">
        <p class="text-sm md:text-base">⚡ <strong>Quick Response:</strong> Contact us anytime for instant quotes</p>
      </div>
    </div>
  </section>

  <section id="products" class="bg-gray-50 py-16 md:py-24 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-gray-800">Our Products</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {content.products.map((product) => (
          <div class="product-card bg-white p-6 md:p-8 rounded-lg shadow hover:shadow-lg hover:-translate-y-2 transition transform border-t-4 border-blue-600">
            <div class="text-4xl mb-4">{product.emoji}</div>
            <h3 class="text-xl md:text-lg font-bold text-blue-600 mb-3">{product.title}</h3>
            <p class="text-gray-600 text-sm md:text-base">{product.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="about" class="py-16 md:py-24 px-4 bg-white">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-gray-800">{content.about.title}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {content.about.features.map((feature) => (
          <div class="feature bg-gradient-to-br from-blue-50 to-blue-100 p-6 md:p-8 rounded-lg border-l-4 border-blue-600 hover:shadow-md transition">
            <h3 class="text-lg md:text-xl font-bold text-blue-600 mb-3">{feature.title}</h3>
            <p class="text-gray-700 text-sm md:text-base">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="bg-gray-50 py-16 md:py-24 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-gray-800">{content.contact.title}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white p-6 md:p-8 rounded-lg shadow">
          <h3 class="text-xl md:text-2xl font-bold text-blue-600 mb-6">Contact Information</h3>
          <div class="space-y-4">
            <div>
              <strong class="text-blue-600 block">📍 Address:</strong>
              <p class="text-gray-700 text-sm md:text-base">{content.contact.address}</p>
            </div>
            <div>
              <strong class="text-blue-600 block">📞 Phone:</strong>
              <p class="text-gray-700 text-sm md:text-base">{content.contact.phone}</p>
            </div>
            <div>
              <strong class="text-blue-600 block">📧 Email:</strong>
              <p class="text-gray-700 text-sm md:text-base">{content.contact.email}</p>
            </div>
            <div>
              <strong class="text-blue-600 block">⏰ Business Hours:</strong>
              <p class="text-gray-700 text-sm md:text-base">{content.contact.hours}</p>
            </div>
          </div>
        </div>
        <form class="bg-white p-6 md:p-8 rounded-lg shadow space-y-4">
          <div>
            <label for="name" class="block font-semibold text-gray-700 mb-2">Full Name</label>
            <input type="text" id="name" name="name" required class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-200 text-sm md:text-base" />
          </div>
          <div>
            <label for="email" class="block font-semibold text-gray-700 mb-2">Email</label>
            <input type="email" id="email" name="email" required class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-200 text-sm md:text-base" />
          </div>
          <div>
            <label for="message" class="block font-semibold text-gray-700 mb-2">Message</label>
            <textarea id="message" name="message" rows="5" required class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-200 text-sm md:text-base"></textarea>
          </div>
          <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded transition text-base md:text-lg">Send Message</button>
        </form>
      </div>
    </div>
  </section>

  <footer class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-8 px-4 text-center">
    <div class="max-w-6xl mx-auto">
      <p class="mb-2 text-sm md:text-base">{content.footer}</p>
      <p class="text-xs md:text-sm opacity-90">Made with care for our clients worldwide</p>
    </div>
  </footer>

  <script>
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');

    menuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    const mascot = document.getElementById('mascot');
    const mascotMessage = document.getElementById('mascot-message');
    const messageText = document.getElementById('message-text');

    const messages = [
      '👋 Need help?',
      '❓ Questions?',
      '💬 Chat with me!',
      '🎉 Let\'s talk!',
      '✨ Ready to help!'
    ];

    let messageIndex = 0;

    setTimeout(() => {
      const mascotContainer = document.getElementById('mascot-container');
      mascotContainer.style.animation = 'slideIn 0.5s ease-out';
    }, 2000);

    mascot.addEventListener('mouseenter', () => {
      mascotMessage.classList.remove('hidden');
      mascotMessage.classList.add('bounce-in');
    });

    mascot.addEventListener('mouseleave', () => {
      mascotMessage.classList.add('hidden');
    });

    mascot.addEventListener('click', () => {
      messageIndex = (messageIndex + 1) % messages.length;
      messageText.textContent = messages[messageIndex];
      mascot.style.animation = 'spin 0.5s ease-out';
      setTimeout(() => {
        mascot.style.animation = '';
      }, 500);
    });

    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
          if (!mobileMenu.classList.contains('hidden')) {
            mobileMenu.classList.add('hidden');
          }
        }
      });
    });
  </script>
</BaseLayout>
